{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/feature-execution/agent-turn.schema.json",
  "title": "Feature Execution agent turn",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "terminal_state",
    "summary",
    "progress_made",
    "progress_fingerprint",
    "root_cause",
    "requested_user_instruction",
    "evidence_refs",
    "context_loaded",
    "rubric_scores",
    "commands_run",
    "observations",
    "modified_files"
  ],
  "properties": {
    "terminal_state": {
      "type": "string",
      "enum": ["in_progress", "verified_outcome", "real_blocker", "needs_authorization", "no_progress"]
    },
    "summary": {"type": "string", "minLength": 1},
    "progress_made": {"type": "boolean"},
    "progress_fingerprint": {"type": "string"},
    "root_cause": {"type": "string"},
    "requested_user_instruction": {"type": "boolean"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "context_loaded": {"type": "array", "items": {"type": "string"}},
    "rubric_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "score"],
        "properties": {
          "criterion": {"type": "string"},
          "score": {"type": "number", "minimum": 0, "maximum": 10}
        }
      }
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "result"],
        "properties": {
          "command": {"type": "string"},
          "exit_code": {"type": ["integer", "null"]},
          "result": {"type": "string"}
        }
      }
    },
    "observations": {"type": "array", "items": {"type": "string"}},
    "modified_files": {"type": "array", "items": {"type": "string"}},
    "task_id": {
      "type": "string",
      "pattern": "^T[0-9]{3}$"
    },
    "session_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "task_id", "mode"],
      "properties": {
        "batch_id": {"type": "string", "pattern": "^B[0-9]{3}$"},
        "task_id": {"type": "string", "pattern": "^T[0-9]{3}$"},
        "mode": {"type": "string", "enum": ["fresh", "continue"]},
        "from_task": {"type": "string", "pattern": "^T[0-9]{3}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "continue"}}},
          "then": {"required": ["from_task"]},
          "else": {"not": {"required": ["from_task"]}}
        }
      ]
    },
    "capability_preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "required_capabilities"],
      "properties": {
        "phase": {"const": "final_verification"},
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
        }
      }
    }
  }
}
